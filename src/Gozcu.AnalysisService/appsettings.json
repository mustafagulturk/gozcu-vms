{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Gozcu": "Host=localhost;Port=5432;Database=gozcu;Username=gozcu;Password=gozcu"
  },
  "RabbitMq": {
    "ConnectionString": "amqp://gozcu:gozcu@localhost:5672/",
    "ClientName": "gozcu-analysis"
  },
  "Analysis": {
    "FfmpegPath": "ffmpeg",
    "FramesPerSecond": 2,
    "ModelPath": "models/yolox_tiny.onnx",
    "ConfidenceThreshold": 0.35,
    "NmsThreshold": 0.45,
    "MaxDetections": 100,
    "MaxConcurrentInferences": 2,
    "IntraOpThreads": 2,
    "FrameRetention": "7.00:00:00",
    "Events": {
      "MinConfidence": 0.5,
      "MinConsecutiveFrames": 2,
      "EndAfter": "00:00:05"
    }
  },
  "Cameras": [
    {
      "Id": "cam1",
      "Name": "Otopark Girişi",
      "RtspUrl": "rtsp://localhost:8554/cam1"
    },
    {
      "Id": "cam2",
      "Name": "Otopark Alanı",
      "RtspUrl": "rtsp://localhost:8554/cam2"
    },
    {
      "Id": "cam3",
      "Name": "Koridor",
      "RtspUrl": "rtsp://localhost:8554/cam3"
    },
    {
      "Id": "cam4",
      "Name": "Lobi",
      "RtspUrl": "rtsp://localhost:8554/cam4"
    }
  ]
}
