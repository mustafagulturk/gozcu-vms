{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Gozcu": "Host=localhost;Port=5432;Database=gozcu;Username=gozcu;Password=gozcu"
  },
  "RabbitMq": {
    "ConnectionString": "amqp://gozcu:gozcu@localhost:5672/",
    "ClientName": "gozcu-recording"
  },
  "Recording": {
    "FfmpegPath": "ffmpeg",
    "RootPath": "recordings",
    "SegmentSeconds": 60,
    "Retention": {
      "MaxTotalBytes": 10737418240,
      "MinFreeBytes": 1073741824,
      "CheckInterval": "00:00:30"
    },
    "Playback": {
      "MaxExportDuration": "01:00:00",
      "PublicLiveUrl": "http://localhost:5080/"
    }
  },
  "Cameras": [
    {
      "Id": "cam1",
      "Name": "Otopark Girişi",
      "RtspUrl": "rtsp://localhost:8554/cam1"
    },
    {
      "Id": "cam2",
      "Name": "Otopark Alanı",
      "RtspUrl": "rtsp://localhost:8554/cam2"
    },
    {
      "Id": "cam3",
      "Name": "Koridor",
      "RtspUrl": "rtsp://localhost:8554/cam3"
    },
    {
      "Id": "cam4",
      "Name": "Lobi",
      "RtspUrl": "rtsp://localhost:8554/cam4"
    }
  ]
}
