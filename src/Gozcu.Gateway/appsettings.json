{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "cameras": {
        "ClusterId": "streaming",
        "Match": { "Path": "/api/cameras/{**rest}" }
      },
      "recordings": {
        "ClusterId": "recording",
        "Match": { "Path": "/api/recordings/{**rest}" }
      },
      "playback": {
        "ClusterId": "recording",
        "Match": { "Path": "/api/playback/{**rest}" }
      },
      "analysis": {
        "ClusterId": "analysis",
        "Match": { "Path": "/api/analysis/{**rest}" }
      },
      "hls": {
        "ClusterId": "hls",
        "Match": { "Path": "/hls/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/hls" } ]
      }
    },
    "Clusters": {
      "streaming": {
        "Destinations": { "default": { "Address": "http://localhost:5080/" } }
      },
      "recording": {
        "Destinations": { "default": { "Address": "http://localhost:5081/" } }
      },
      "analysis": {
        "Destinations": { "default": { "Address": "http://localhost:5082/" } }
      },
      "hls": {
        "Destinations": { "default": { "Address": "http://localhost:8888/" } }
      }
    }
  }
}
