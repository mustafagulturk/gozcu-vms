<Project Sdk="Microsoft.NET.Sdk">
  <!-- Docker ve ana makinede ffmpeg gerektirir. CI'da ayrı adımda çalışır. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2234;CA1062;CA1001;CA1063;CA1816</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gozcu.Media\Gozcu.Media.csproj" />
    <ProjectReference Include="..\..\src\Gozcu.Infrastructure\Gozcu.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Gozcu.StreamingService\Gozcu.StreamingService.csproj" />
    <ProjectReference Include="..\..\src\Gozcu.RecordingService\Gozcu.RecordingService.csproj" />
    <ProjectReference Include="..\..\src\Gozcu.Vision\Gozcu.Vision.csproj" />
    <ProjectReference Include="..\..\src\Gozcu.AnalysisService\Gozcu.AnalysisService.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Update="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
